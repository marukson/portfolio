# Modelo de configuración. Copialo como .env (ese no se sube a git).
# WP_URL: dirección del WordPress que tiene el contenido (sin barra al final).
#   En tu compu con LocalWP:  http://marugarcianew.local
#   Online:                   https://marugarcia.dev-site.ar
# En Cloudflare Pages esta variable se carga en el panel del proyecto.
WP_URL=https://marugarcia.dev-site.ar
