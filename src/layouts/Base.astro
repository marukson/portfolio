---
/*
 * Estructura común de todas las páginas.
 * Equivale a header.php + footer.php: el contenido de cada página entra en <slot />.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  boot?: boolean; // arranque "la tele se enciende" (solo la home)
}

const {
  title = 'Maru Garcia · Diseño y desarrollo web a medida',
  description = 'Frontend developer con formación en diseño industrial y experiencia en diseño gráfico.',
  boot = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {boot && (
      <script is:inline>
      /* Arranque (la tele se enciende): se decide antes de pintar para que no se vea el sitio un instante.
         Una vez por sesión; no corre si la persona pidió menos movimiento. #boot en la URL lo fuerza. */
      try{if(location.hash==='#boot'||(!sessionStorage.getItem('mg-boot')&&!matchMedia('(prefers-reduced-motion: reduce)').matches))document.documentElement.classList.add('booting')}catch(e){}
      </script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" />
  </head>
  <body>
    <Header />

    <!-- Barrida del cambio de canal (ojo) -->
    <div class="tune" aria-hidden="true"></div>

    <!-- Lugar para elementos fijos de una página, fuera de <main> (ej. el canvas de la señal) -->
    <slot name="fuera" />

    <main id="top" class="main">
      <slot />
      <Footer />
    </main>

    <!-- Astro procesa este script: resuelve los imports y lo empaqueta -->
    <script>
      import '../scripts/portfolio.js';
    </script>
  </body>
</html>
